rules_version = '2';

// =====================================================================
//  HVAC 360° · Reglas de seguridad de Cloud Firestore
//  Fase 1.5 · Base multiempresa (SaaS) · VERSIÓN PLAN GRATUITO (Spark)
//
//  Diferencia con la versión anterior:
//  Antes el rol y la empresa del usuario viajaban en el token (custom
//  claims) y solo Cloud Functions podía asignarlos. Eso obligaba a
//  contratar el plan Blaze.
//
//  Ahora el rol y la empresa viven en un documento de Firestore:
//      /tenants/{empresaId}/members/{uid}
//  Ese documento SOLO lo puede escribir un administrador de la misma
//  empresa, y nadie puede tocar el suyo propio. Las reglas lo leen en
//  cada operación, así que el efecto de seguridad es el mismo, sin
//  necesidad de servidor.
//
//  Ventaja adicional: un cambio de rol es inmediato. Con el token había
//  que volver a iniciar sesión para que surtiera efecto.
//  Costo: cada operación lee 1 o 2 documentos extra. Con el tope gratis
//  de 50.000 lecturas diarias eso da para miles de operaciones al día.
//
//  Roles: admin · coordinador · tecnico · cliente
//  Estados de orden: pendiente · programada · en_ruta · en_servicio · completada · cancelada
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    //  Identidad y roles (leídos de Firestore, no del token)
    // ---------------------------------------------------------------
    function signedIn() { return request.auth != null; }
    function uid()      { return request.auth.uid; }

    function tenantPath(t) { return /databases/$(database)/documents/tenants/$(t); }
    function memberPath(t) { return /databases/$(database)/documents/tenants/$(t)/members/$(uid()); }

    // ¿Existe la ficha de este usuario en esta empresa y está activa?
    function inTenant(t) {
      return signedIn() && exists(memberPath(t)) && get(memberPath(t)).data.active == true;
    }
    function me(t)   { return get(memberPath(t)).data; }
    function role(t) { return me(t).role; }

    function hasRole(t, roles) { return inTenant(t) && role(t) in roles; }

    function isAdmin(t)    { return hasRole(t, ['admin']); }
    function isManager(t)  { return hasRole(t, ['admin', 'coordinador']); }
    function isStaff(t)    { return hasRole(t, ['admin', 'coordinador', 'tecnico']); }
    function isTech(t)     { return hasRole(t, ['tecnico']); }
    function isCustomer(t) { return hasRole(t, ['cliente']); }

    // El cliente del portal trae su clientId en su propia ficha de miembro.
    function myClientId(t) { return me(t).get('clientId', ''); }

    // ---------------------------------------------------------------
    //  Estado de la empresa (suscripción)
    // ---------------------------------------------------------------
    function tenantActive(t) { return get(tenantPath(t)).data.status in ['prueba', 'activo']; }
    function canManage(t)    { return isManager(t) && tenantActive(t); }

    // ---------------------------------------------------------------
    //  Utilidades de validación
    // ---------------------------------------------------------------
    function newData()       { return request.resource.data; }
    function oldData()       { return resource.data; }
    function changedKeys()   { return newData().diff(oldData()).affectedKeys(); }
    function unchanged(keys) { return !changedKeys().hasAny(keys); }

    function str(v, min, max)  { return v is string && v.size() >= min && v.size() <= max; }
    function optStr(d, k, max) { return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max); }
    function isDate(v)         { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function optDate(d, k)     { return !(k in d) || d[k] == null || isDate(d[k]); }
    function optTime(d, k)     { return !(k in d) || d[k] == null || (d[k] is string && d[k].matches('^[0-9]{2}:[0-9]{2}$')); }

    function createdStamp() {
      return newData().createdAt == request.time && newData().createdBy == uid()
          && newData().updatedAt == request.time && newData().updatedBy == uid();
    }
    function updatedStamp() {
      return newData().updatedAt == request.time && newData().updatedBy == uid()
          && unchanged(['createdAt', 'createdBy']);
    }

    // =================================================================
    //  COLECCIONES GLOBALES
    // =================================================================

    // Planes comerciales. Solo lectura; se cargan desde la consola.
    match /plans/{planId} {
      allow read: if true;
      allow write: if false;
    }

    // Índice global: a qué empresa pertenece cada usuario.
    // Lo escribe el propio usuario al registrarse, y solo una vez.
    match /users/{userId} {
      allow read:   if signedIn() && uid() == userId;
      // Lo crea el propio usuario al registrar su empresa, o un admin de
      // esa empresa al dar de alta a un técnico o coordinador.
      allow create: if signedIn()
                    && newData().keys().hasOnly(['tenantId', 'email', 'createdAt'])
                    && str(newData().tenantId, 1, 64)
                    && newData().createdAt == request.time
                    && (uid() == userId || isAdmin(newData().tenantId));
      allow update, delete: if false;
    }

    // =================================================================
    //  EMPRESA (TENANT)
    // =================================================================
    match /tenants/{t} {
      allow read: if inTenant(t);

      // Registro de una empresa nueva: quien la crea debe quedar como
      // administrador en la MISMA operación, y la empresa nace en prueba.
      allow create: if signedIn()
        && newData().status == 'prueba'
        && newData().createdBy == uid()
        && newData().createdAt == request.time
        && str(newData().name, 2, 120)
        && getAfter(memberPath(t)).data.role == 'admin';

      allow delete: if false;

      // El plan y el estado NO se cambian desde la app: eso se hace
      // desde la consola de Firebase (usted, como dueño de la plataforma).
      allow update: if isAdmin(t) && tenantActive(t)
        && changedKeys().hasOnly(['name', 'legalName', 'nit', 'phone', 'email', 'address', 'city', 'logoUrl', 'settings', 'updatedAt', 'updatedBy'])
        && str(newData().name, 2, 120)
        // El logo se guarda como imagen pequeña dentro del propio documento.
        && optStr(newData(), 'logoUrl', 140000)
        && newData().updatedAt == request.time && newData().updatedBy == uid();

      // ---------------- Miembros: aquí vive el rol ----------------
      //  Esta es la pieza que reemplaza a Cloud Functions.
      //  Candados: nadie puede tocar su propia ficha (ni ascenderse, ni
      //  desactivarse), y solo un admin de la misma empresa puede crear
      //  o modificar la de otro.
      match /members/{memberId} {
        allow read: if isManager(t) || (signedIn() && uid() == memberId);

        // Caso 1 · Arranque: el fundador se crea a sí mismo como admin
        //          junto con la empresa (la empresa aún no existía).
        // Caso 2 · Normal: un admin da de alta a otra persona.
        allow create: if
          (
            memberId == uid()
            && newData().role == 'admin'
            && !exists(tenantPath(t))
            && getAfter(tenantPath(t)).data.createdBy == uid()
            && validMember(newData())
          )
          || (
            isAdmin(t) && tenantActive(t)
            && memberId != uid()
            && validMember(newData())
          );

        // Un admin cambia el rol o activa/desactiva a OTRA persona.
        // Nunca a sí mismo: así una empresa no se queda sin administrador
        // por un clic equivocado.
        allow update: if isAdmin(t) && tenantActive(t)
          && memberId != uid()
          && validMember(newData())
          && unchanged(['createdAt', 'createdBy']);

        allow delete: if false;
      }
      function validMember(d) {
        return d.keys().hasOnly(['name', 'email', 'role', 'active', 'clientId', 'branchId',
                                 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && str(d.name, 2, 100)
          && d.role in ['admin', 'coordinador', 'tecnico', 'cliente']
          && d.active is bool
          && optStr(d, 'email', 120) && optStr(d, 'branchId', 64)
          // Un usuario del portal del cliente DEBE estar amarrado a un cliente.
          && (d.role != 'cliente' || str(d.get('clientId', ''), 1, 64))
          && (d.role == 'cliente' || d.get('clientId', null) == null);
      }

      // ---------------- Contadores (consecutivos OT-0001...) ----------------
      match /counters/{name} {
        allow read: if isManager(t);
        // El admin crea el contador en cero al terminar de registrar la
        // empresa. Después ya solo puede subir de uno en uno.
        allow create: if isAdmin(t) && tenantActive(t)
          && newData().keys().hasOnly(['value'])
          && newData().value == 0;
        allow delete: if false;
        allow update: if canManage(t)
          && newData().keys().hasOnly(['value'])
          && newData().value == oldData().value + 1;
      }

      // ---------------- Sucursales / regionales ----------------
      match /branches/{branchId} {
        allow read: if isStaff(t);
        allow create: if isAdmin(t) && tenantActive(t) && validBranch(newData()) && createdStamp();
        allow update: if isAdmin(t) && tenantActive(t) && validBranch(newData()) && updatedStamp();
        allow delete: if false;
      }
      function validBranch(d) {
        return d.keys().hasOnly(['name', 'city', 'active', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && str(d.name, 2, 100) && optStr(d, 'city', 80) && d.active is bool;
      }

      // ---------------- Clientes ----------------
      match /clients/{clientId} {
        allow read: if isStaff(t) || (isCustomer(t) && clientId == myClientId(t));
        allow create: if canManage(t) && validClient(newData()) && createdStamp();
        allow update: if canManage(t) && validClient(newData()) && updatedStamp();
        allow delete: if false;
      }
      function validClient(d) {
        return d.keys().hasOnly(['name', 'nit', 'contact', 'phone', 'email', 'address', 'city', 'branchId', 'status', 'notes',
                                 'portalUid', 'portalEmail',
                                 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && optStr(d, 'portalUid', 128) && optStr(d, 'portalEmail', 120)
          && str(d.name, 2, 150)
          && d.status in ['activo', 'inactivo']
          && optStr(d, 'nit', 30) && optStr(d, 'contact', 100) && optStr(d, 'phone', 40)
          && optStr(d, 'email', 120) && optStr(d, 'address', 200) && optStr(d, 'city', 80)
          && optStr(d, 'branchId', 64) && optStr(d, 'notes', 2000);
      }

      // ---------------- Sedes ----------------
      match /sites/{siteId} {
        allow read: if isStaff(t) || (isCustomer(t) && resource.data.clientId == myClientId(t));
        allow create: if canManage(t) && validSite(newData()) && createdStamp()
          && exists(/databases/$(database)/documents/tenants/$(t)/clients/$(newData().clientId));
        allow update: if canManage(t) && validSite(newData()) && updatedStamp() && unchanged(['clientId']);
        allow delete: if false;
      }
      function validSite(d) {
        return d.keys().hasOnly(['clientId', 'name', 'city', 'address', 'contact', 'phone', 'lat', 'lng', 'active',
                                 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && str(d.clientId, 1, 64) && str(d.name, 2, 120) && d.active is bool
          && optStr(d, 'city', 80) && optStr(d, 'address', 200) && optStr(d, 'contact', 100) && optStr(d, 'phone', 40)
          && (!('lat' in d) || d.lat == null || d.lat is number)
          && (!('lng' in d) || d.lng == null || d.lng is number);
      }

      // ---------------- Equipos HVAC ----------------
      match /assets/{assetId} {
        allow read: if isStaff(t) || (isCustomer(t) && resource.data.clientId == myClientId(t));
        allow create: if canManage(t) && validAsset(newData()) && createdStamp()
          && get(/databases/$(database)/documents/tenants/$(t)/sites/$(newData().siteId)).data.clientId == newData().clientId;
        // Mover un equipo de cliente o sede se hace borrando y creando de
        // nuevo, para no perder el historial de órdenes ya hechas.
        allow update: if canManage(t) && validAsset(newData()) && updatedStamp() && unchanged(['clientId', 'siteId', 'code']);
        allow delete: if false;
      }
      function validAsset(d) {
        return d.keys().hasOnly(['code', 'clientId', 'siteId', 'location', 'type', 'brand', 'model', 'serial', 'btu',
                                 'refrigerant', 'installDate', 'warrantyUntil', 'status', 'qr',
                                 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && str(d.code, 3, 30) && str(d.clientId, 1, 64) && str(d.siteId, 1, 64)
          && str(d.type, 2, 40) && str(d.brand, 1, 60)
          && d.status in ['operativo', 'requiere_atencion', 'fuera_de_servicio']
          && optStr(d, 'location', 120) && optStr(d, 'model', 60) && optStr(d, 'serial', 60)
          && optStr(d, 'refrigerant', 20) && optStr(d, 'qr', 120)
          && (!('btu' in d) || d.btu == null || (d.btu is int && d.btu >= 0 && d.btu <= 10000000))
          && optDate(d, 'installDate') && optDate(d, 'warrantyUntil');
      }

      // ---------------- Técnicos (ficha operativa) ----------------
      match /technicians/{techId} {
        allow read: if isStaff(t);
        allow create: if canManage(t) && validTech(newData()) && createdStamp();
        allow update: if canManage(t) && validTech(newData()) && updatedStamp();
        allow delete: if false;
      }
      function validTech(d) {
        return d.keys().hasOnly(['name', 'phone', 'email', 'specialties', 'branchId', 'active', 'uid', 'warehouseId',
                                 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && optStr(d, 'warehouseId', 64)
          && str(d.name, 2, 100) && d.active is bool
          && optStr(d, 'phone', 40) && optStr(d, 'email', 120) && optStr(d, 'branchId', 64)
          && optStr(d, 'uid', 128)
          && (!('specialties' in d) || (d.specialties is list && d.specialties.size() <= 20));
      }

      // ---------------- Bodegas y existencias ----------------
      match /warehouses/{wid} {
        allow read: if isStaff(t);
        allow create: if canManage(t) && validWarehouse(newData()) && createdStamp();
        allow update: if canManage(t) && validWarehouse(newData()) && updatedStamp();
        allow delete: if false;

        // La existencia solo la mueve la oficina. El técnico la lee para
        // saber si hay repuesto, pero nunca la toca.
        match /stock/{partId} {
          allow read: if isStaff(t);
          allow write: if canManage(t)
            && newData().keys().hasOnly(['qty', 'updatedAt', 'updatedBy'])
            && newData().qty is number && newData().qty >= 0
            && newData().updatedAt == request.time && newData().updatedBy == uid();
        }
      }
      function validWarehouse(d) {
        return d.keys().hasOnly(['name', 'city', 'active', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && str(d.name, 2, 100) && optStr(d, 'city', 80) && d.active is bool;
      }

      // ---------------- Catálogo de repuestos ----------------
      match /parts/{pid} {
        allow read: if isStaff(t);
        allow create: if canManage(t) && validPart(newData()) && createdStamp();
        allow update: if canManage(t) && validPart(newData()) && updatedStamp();
        allow delete: if false;
      }
      function validPart(d) {
        return d.keys().hasOnly(['code', 'name', 'unit', 'category', 'cost', 'price', 'minStock', 'active',
                                 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && str(d.code, 1, 30) && str(d.name, 2, 120) && str(d.unit, 1, 20)
          && optStr(d, 'category', 60) && d.active is bool
          && d.cost is number && d.cost >= 0
          && d.price is number && d.price >= 0
          && d.minStock is number && d.minStock >= 0;
      }

      // ---------------- Movimientos de inventario ----------------
      //  El técnico PIDE la salida de un repuesto desde su orden: queda
      //  pendiente y no mueve nada. La oficina la aprueba o la rechaza, y
      //  es ahí donde baja la existencia.
      match /movements/{mid} {
        allow read: if isStaff(t);

        allow create: if tenantActive(t) && validMovement(newData()) && createdStamp()
          && (
            canManage(t)
            || ( isTech(t)
                 && newData().type == 'salida'
                 && newData().status == 'pendiente'
                 && newData().requestedBy == uid()
                 && get(/databases/$(database)/documents/tenants/$(t)/workOrders/$(newData().orderId)).data.techUid == uid() )
          );

        allow update: if canManage(t) && validMovement(newData()) && updatedStamp()
          && oldData().status == 'pendiente'
          && newData().status in ['aprobado', 'rechazado']
          && unchanged(['type', 'partId', 'warehouseId', 'qty', 'orderId', 'requestedBy']);

        allow delete: if false;
      }
      function validMovement(d) {
        return d.keys().hasOnly(['type', 'partId', 'partName', 'warehouseId', 'qty', 'unitCost',
                                 'orderId', 'orderNumber', 'note', 'status',
                                 'requestedBy', 'requestedByName', 'approvedBy',
                                 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && d.type in ['entrada', 'salida', 'ajuste']
          && str(d.partId, 1, 64) && str(d.warehouseId, 1, 64)
          && d.qty is number && d.qty != 0
          && d.status in ['pendiente', 'aprobado', 'rechazado']
          && optStr(d, 'partName', 120) && optStr(d, 'orderId', 64) && optStr(d, 'orderNumber', 20)
          && optStr(d, 'note', 500) && optStr(d, 'requestedBy', 128)
          && optStr(d, 'requestedByName', 100) && optStr(d, 'approvedBy', 128)
          && (!('unitCost' in d) || d.unitCost == null || (d.unitCost is number && d.unitCost >= 0));
      }

      // ---------------- Contratos de mantenimiento ----------------
      match /contracts/{contractId} {
        allow read: if isStaff(t) || (isCustomer(t) && resource.data.clientId == myClientId(t));
        allow create: if canManage(t) && validContract(newData()) && createdStamp();
        allow update: if canManage(t) && validContract(newData()) && updatedStamp() && unchanged(['clientId']);
        allow delete: if false;
      }
      function validContract(d) {
        return d.keys().hasOnly(['name','clientId','clientName','siteIds','frequency','mode','overrides',
                                 'startDate','endDate','techId','status','notes','lastRun','valorMensual',
                                 'createdAt','createdBy','updatedAt','updatedBy'])
          && str(d.name, 2, 120)
          && str(d.clientId, 1, 64)
          && d.frequency in ['mensual','bimestral','trimestral','semestral','anual']
          && d.mode in ['visita','equipo']
          && d.status in ['activo','suspendido','terminado']
          && isDate(d.startDate) && optDate(d, 'endDate')
          && d.siteIds is list && d.siteIds.size() <= 200
          && optStr(d, 'techId', 64) && optStr(d, 'notes', 2000) && optStr(d, 'clientName', 150)
          && optDate(d, 'lastRun')
          && (!('valorMensual' in d) || d.valorMensual == null
              || (d.valorMensual is number && d.valorMensual >= 0));
      }

      // ---------------- Cotizaciones ----------------
      //  La oficina la arma (borrador), la envía al cliente, y el cliente
      //  la aprueba o la rechaza desde su portal. Una vez aprobada queda
      //  congelada: es el precio que el cliente avaló. Lo único que se le
      //  puede pegar después es el número de la orden que se generó con ella.
      //  El cliente nunca ve los borradores.
      match /quotes/{qid} {
        allow read: if isStaff(t)
          || ( isCustomer(t) && resource.data.clientId == myClientId(t)
               && resource.data.status in ['enviada', 'aprobada', 'rechazada', 'vencida'] );

        allow create: if canManage(t) && validQuote(newData()) && createdStamp()
          && newData().status in ['borrador', 'enviada']
          && newData().get('decidedBy', null) == null
          && newData().get('resultOrderId', null) == null;

        allow update: if oficinaEditaCot() || oficinaLigaOrden() || clienteDecide();

        allow delete: if false;

        //  La oficina solo edita mientras el cliente no haya decidido.
        function oficinaEditaCot() {
          return canManage(t) && validQuote(newData()) && updatedStamp()
            && oldData().status in ['borrador', 'enviada', 'rechazada', 'vencida']
            && newData().status in ['borrador', 'enviada', 'rechazada', 'vencida', 'anulada']
            && unchanged(['seq', 'number', 'clientId', 'decidedBy', 'decidedAt', 'clientNote', 'resultOrderId']);
        }
        //  Aprobada + se le pega la orden de trabajo que salió de ella. Una sola vez.
        function oficinaLigaOrden() {
          return canManage(t) && updatedStamp()
            && oldData().status == 'aprobada'
            && changedKeys().hasOnly(['resultOrderId', 'updatedAt', 'updatedBy'])
            && oldData().get('resultOrderId', null) == null
            && newData().resultOrderId is string;
        }
        //  El cliente solo decide sobre lo que se le envió, y solo lo suyo.
        function clienteDecide() {
          return isCustomer(t) && tenantActive(t) && updatedStamp()
            && oldData().clientId == myClientId(t)
            && oldData().status == 'enviada'
            && newData().status in ['aprobada', 'rechazada']
            && changedKeys().hasOnly(['status', 'clientNote', 'decidedBy', 'decidedAt', 'updatedAt', 'updatedBy'])
            && newData().decidedBy == uid()
            && newData().decidedAt == request.time
            && optStr(newData(), 'clientNote', 1000);
        }
      }
      function validQuote(d) {
        return d.keys().hasOnly(['seq', 'number', 'clientId', 'clientName', 'siteId', 'siteName',
                                 'orderId', 'orderNumber', 'assetId', 'title', 'date', 'validUntil',
                                 'items', 'notes', 'subtotal', 'ivaPct', 'ivaValue', 'total',
                                 'status', 'clientNote', 'decidedBy', 'decidedAt', 'resultOrderId',
                                 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && d.seq is number && d.seq > 0
          && str(d.number, 3, 20)
          && str(d.clientId, 1, 64)
          && str(d.title, 3, 140)
          && isDate(d.date) && optDate(d, 'validUntil')
          && d.status in ['borrador', 'enviada', 'aprobada', 'rechazada', 'vencida', 'anulada']
          && d.items is list && d.items.size() >= 1 && d.items.size() <= 60
          && d.subtotal is number && d.subtotal >= 0
          && d.ivaPct is number && d.ivaPct >= 0 && d.ivaPct <= 100
          && d.ivaValue is number && d.ivaValue >= 0
          && d.total is number && d.total >= 0
          && optStr(d, 'clientName', 150) && optStr(d, 'siteId', 64) && optStr(d, 'siteName', 150)
          && optStr(d, 'orderId', 64) && optStr(d, 'orderNumber', 20) && optStr(d, 'assetId', 64)
          && optStr(d, 'notes', 3000) && optStr(d, 'clientNote', 1000)
          && optStr(d, 'decidedBy', 128) && optStr(d, 'resultOrderId', 64);
      }

      // ---------------- Preparación de la factura ----------------
      //  HVAC 360 NO emite factura electrónica: eso lo hace el software
      //  contable con un proveedor autorizado por la DIAN. Aquí solo se
      //  arma el borrador con lo que hay que cobrar, se exporta y después
      //  se anota el número real de la factura. Una vez anotado, se congela.
      match /invoices/{iid} {
        allow read: if isStaff(t);

        allow create: if canManage(t) && validInvoice(newData()) && createdStamp()
          && newData().status == 'borrador'
          && newData().get('siigoNumero', null) == null;

        allow update: if canManage(t) && validInvoice(newData()) && updatedStamp()
          && oldData().status != 'facturada'
          && unchanged(['seq', 'number', 'clientId']);

        allow delete: if false;
      }
      function validInvoice(d) {
        return d.keys().hasOnly(['seq', 'number', 'clientId', 'clientName', 'clientNit',
                                 'period', 'date', 'dueDate', 'kind', 'orderIds', 'contractId',
                                 'consecutivo', 'items', 'notes',
                                 'subtotal', 'ivaPct', 'ivaValue', 'total',
                                 'status', 'siigoNumero',
                                 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && d.seq is number && d.seq > 0
          && str(d.number, 3, 20)
          && str(d.clientId, 1, 64)
          && d.kind in ['orden', 'consolidado', 'contrato']
          && d.status in ['borrador', 'lista', 'facturada', 'anulada']
          && isDate(d.date) && optDate(d, 'dueDate')
          && d.period is string && d.period.matches('^[0-9]{4}-[0-9]{2}$')
          && d.orderIds is list && d.orderIds.size() <= 200
          && d.items is list && d.items.size() >= 1 && d.items.size() <= 200
          && d.subtotal is number && d.subtotal >= 0
          && d.ivaPct is number && d.ivaPct >= 0 && d.ivaPct <= 100
          && d.ivaValue is number && d.ivaValue >= 0
          && d.total is number && d.total >= 0
          && optStr(d, 'clientName', 150) && optStr(d, 'clientNit', 40)
          && optStr(d, 'contractId', 64) && optStr(d, 'consecutivo', 20)
          && optStr(d, 'notes', 2000) && optStr(d, 'siigoNumero', 40);
      }

      // ---------------- Gastos ----------------
      //  Regla dura: un gasto NUNCA lo ve el cliente. Aquí no aparece
      //  isCustomer por ningún lado, así que el portal del cliente no
      //  puede leer ni un solo documento de esta colección.
      //  El técnico solo ve y edita los suyos, y solo mientras estén
      //  pendientes. La oficina aprueba, rechaza y marca el reembolso.
      match /expenses/{eid} {
        function mioGasto() { return isTech(t) && resource.data.techUid == uid(); }

        allow read: if isManager(t) || mioGasto();

        allow create: if tenantActive(t) && validExpense(newData()) && createdStamp()
          && (
            ( canManage(t) && newData().status in ['pendiente', 'aprobado'] )
            || ( isTech(t)
                 && newData().techUid == uid()
                 && newData().status == 'pendiente'
                 && newData().pagado == false
                 && newData().get('aprobadoPor', null) == null )
          );

        allow update: if tenantActive(t) && validExpense(newData()) && updatedStamp()
          && unchanged(['seq', 'number', 'techUid'])
          && (
            canManage(t)
            || ( isTech(t) && oldData().techUid == uid()
                 && oldData().status == 'pendiente'
                 && newData().status == 'pendiente'
                 && newData().pagado == false
                 && changedKeys().hasOnly(['date', 'category', 'concept', 'amount', 'fuente',
                                           'orderId', 'orderNumber', 'proveedor', 'nit', 'soporte',
                                           'thumb', 'nota', 'advanceId', 'updatedAt', 'updatedBy']) )
          );

        allow delete: if false;

        // La foto del recibo va aparte para no engordar el documento.
        match /file/{docId} {
          function gastoPadre() { return get(/databases/$(database)/documents/tenants/$(t)/expenses/$(eid)).data; }
          function dueno() { return isTech(t) && gastoPadre().techUid == uid(); }

          allow read: if isManager(t) || dueno();
          allow create: if tenantActive(t) && (canManage(t) || dueno())
            && newData().keys().hasOnly(['data']) && str(newData().data, 20, 900000);
          allow update: if tenantActive(t)
            && (canManage(t) || (dueno() && gastoPadre().status == 'pendiente'))
            && newData().keys().hasOnly(['data']) && str(newData().data, 20, 900000);
          allow delete: if false;
        }
      }
      function validExpense(d) {
        return d.keys().hasOnly(['seq', 'number', 'date', 'category', 'concept', 'amount', 'fuente',
                                 'techId', 'techUid', 'techName', 'orderId', 'orderNumber',
                                 'proveedor', 'nit', 'soporte', 'thumb', 'nota',
                                 'status', 'aprobadoPor', 'pagado', 'pagadoEl', 'advanceId',
                                 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && d.seq is number && d.seq > 0
          && str(d.number, 3, 20)
          && isDate(d.date)
          && str(d.category, 2, 40)
          && str(d.concept, 2, 200)
          && d.amount is number && d.amount > 0
          && d.fuente in ['reembolsable', 'anticipo', 'empresa']
          && d.status in ['pendiente', 'aprobado', 'rechazado']
          && d.pagado is bool
          && optStr(d, 'techId', 64) && optStr(d, 'techUid', 128) && optStr(d, 'techName', 100)
          && optStr(d, 'orderId', 64) && optStr(d, 'orderNumber', 20)
          && optStr(d, 'proveedor', 120) && optStr(d, 'nit', 40) && optStr(d, 'soporte', 60)
          && optStr(d, 'nota', 500) && optStr(d, 'aprobadoPor', 128) && optStr(d, 'advanceId', 64)
          && optDate(d, 'pagadoEl')
          && (!('thumb' in d) || d.thumb == null
              || (d.thumb is string && d.thumb.size() <= 80000));
      }

      // ---------------- Anticipos a los técnicos ----------------
      //  Plata que se le entrega al técnico por adelantado. Él la legaliza
      //  con gastos de fuente "anticipo". Tampoco la ve el cliente.
      match /advances/{aid} {
        allow read: if isManager(t) || (isTech(t) && resource.data.techUid == uid());
        allow create: if canManage(t) && validAdvance(newData()) && createdStamp();
        allow update: if canManage(t) && validAdvance(newData()) && updatedStamp()
          && unchanged(['seq', 'number', 'techUid', 'amount']);
        allow delete: if false;
      }
      function validAdvance(d) {
        return d.keys().hasOnly(['seq', 'number', 'date', 'techId', 'techUid', 'techName',
                                 'amount', 'devuelto', 'status', 'nota',
                                 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && d.seq is number && d.seq > 0
          && str(d.number, 3, 20) && isDate(d.date)
          && d.amount is number && d.amount > 0
          && d.devuelto is number && d.devuelto >= 0
          && d.status in ['abierto', 'cerrado']
          && optStr(d, 'techId', 64) && optStr(d, 'techUid', 128)
          && optStr(d, 'techName', 100) && optStr(d, 'nota', 300);
      }

      // ---------------- Órdenes de trabajo ----------------
      match /workOrders/{orderId} {
        allow read: if isManager(t)
          || (isTech(t) && resource.data.techUid == uid())
          || (isCustomer(t) && resource.data.clientId == myClientId(t));

        allow create: if canManage(t) && validOrder(newData()) && createdStamp()
          && newData().status in ['pendiente', 'programada']
          && getAfter(/databases/$(database)/documents/tenants/$(t)/counters/workOrders).data.value == newData().seq
          && get(/databases/$(database)/documents/tenants/$(t)/counters/workOrders).data.value == newData().seq - 1
          && get(/databases/$(database)/documents/tenants/$(t)/sites/$(newData().siteId)).data.clientId == newData().clientId;

        allow update: if oldData().status in ['pendiente', 'programada', 'en_ruta', 'en_servicio']
          && validOrder(newData()) && updatedStamp()
          && unchanged(['seq', 'clientId'])
          && (managerUpdate() || techUpdate());

        allow delete: if false;

        function managerUpdate() {
          return canManage(t) && transitionOk(oldData().status, newData().status,
            ['pendiente>programada', 'programada>pendiente', 'programada>en_ruta', 'en_ruta>en_servicio',
             'en_servicio>completada', 'pendiente>cancelada', 'programada>cancelada', 'en_ruta>cancelada',
             'en_servicio>cancelada']);
        }
        function techUpdate() {
          return isTech(t) && tenantActive(t)
            && oldData().techUid == uid()
            && changedKeys().hasOnly(['status', 'statusNote', 'startedAt', 'completedAt', 'updatedAt', 'updatedBy'])
            && transitionOk(oldData().status, newData().status,
                 ['programada>en_ruta', 'en_ruta>en_servicio', 'en_servicio>completada']);
        }

        // ---- Reporte de servicio que el técnico llena en sitio ----
        //  Un solo documento por orden: /workOrders/{id}/report/ficha
        //  Lo llena el técnico asignado o un coordinador. Una vez el
        //  cliente firma, queda cerrado: la firma es la prueba del servicio
        //  y no se puede cambiar lo que el cliente ya avaló.
        match /report/{docId} {
          function ord() { return get(/databases/$(database)/documents/tenants/$(t)/workOrders/$(orderId)).data; }
          function miOrden() { return isTech(t) && ord().techUid == uid(); }

          allow read: if isManager(t) || miOrden()
            || (isCustomer(t) && ord().clientId == myClientId(t));

          allow create: if tenantActive(t) && (isManager(t) || miOrden()) && validReport(newData());

          // Mientras el cliente no haya firmado, se puede seguir editando.
          // Ya firmado queda cerrado, SALVO que la oficina lo reabra: eso
          // borra las dos firmas, exige un motivo y deja escrito quién lo
          // autorizó. Después el técnico vuelve a llenarlo y a recoger la
          // firma buena. Nunca se edita un reporte firmado "por debajo":
          // o está sin firmar, o alguien de la oficina respondió por la
          // reapertura con su nombre.
          allow update: if tenantActive(t) && (isManager(t) || miOrden())
            && validReport(newData())
            && ( sinFirmar() || reapertura() );

          function sinFirmar() {
            return !('firmaCliente' in oldData()) || oldData().firmaCliente == null;
          }
          function reapertura() {
            return canManage(t)
              && oldData().get('firmaCliente', null) != null
              && newData().get('firmaCliente', null) == null
              && newData().get('firmaTecnico', null) == null
              && newData().reabiertoPor == uid()
              && newData().reabiertoEl == request.time
              && str(newData().get('reabiertoMotivo', ''), 3, 300);
          }

          allow delete: if false;
        }
        // Si el servicio consumió materiales, el reporte firmado debe
        // señalar una foto real de cada fase. No se cuentan fotos (las
        // reglas no pueden), se exige que las tres existan y que cada una
        // sea de la fase que dice ser.
        function exigeEvidencia(d) {
          return d.get('firmaCliente', null) != null && d.get('materiales', []).size() > 0;
        }
        function fotoDeFase(d, fase) {
          return d.get('evidencia', {}).get(fase, '') is string
            && d.get('evidencia', {}).get(fase, '').size() > 0
            && exists(/databases/$(database)/documents/tenants/$(t)/workOrders/$(orderId)/photos/$(d.evidencia[fase]))
            && get(/databases/$(database)/documents/tenants/$(t)/workOrders/$(orderId)/photos/$(d.evidencia[fase])).data.fase == fase;
        }
        function validReport(d) {
          return d.keys().hasOnly(['tipo','horaEntrada','horaSalida','equipos','checks','materiales',
                                   'actividad','datos','recomendaciones','observaciones','evaluacion',
                                   'evidencia',
                                   'firmaCliente','firmaClienteNombre','firmaTecnico','firmaTecnicoNombre',
                                   'reabiertoPor','reabiertoEl','reabiertoMotivo',
                                   'createdAt','createdBy','updatedAt','updatedBy'])
            && ( !exigeEvidencia(d)
                 || (fotoDeFase(d,'antes') && fotoDeFase(d,'durante') && fotoDeFase(d,'despues')) )
            && d.tipo in ['preventivo','correctivo']
            && d.updatedAt == request.time && d.updatedBy == uid()
            && optStr(d, 'actividad', 4000)
            && optStr(d, 'recomendaciones', 2000)
            && optStr(d, 'observaciones', 2000)
            && optStr(d, 'firmaClienteNombre', 120)
            && optStr(d, 'firmaTecnicoNombre', 120)
            && optStr(d, 'reabiertoPor', 128)
            && optStr(d, 'reabiertoMotivo', 300)
            // Las firmas son imágenes pequeñas guardadas como texto.
            && optStr(d, 'firmaCliente', 260000)
            && optStr(d, 'firmaTecnico', 260000);
        }

        // ---- Registro fotográfico: antes, durante y después ----
        //  Cada foto es un documento aparte, comprimida por la app antes
        //  de subirla. Así no engorda el reporte y solo se descarga cuando
        //  alguien de verdad la mira.
        match /photos/{photoId} {
          function fOrd()  { return get(/databases/$(database)/documents/tenants/$(t)/workOrders/$(orderId)).data; }
          function fMia()  { return isTech(t) && fOrd().techUid == uid(); }
          function fFicha(){ return /databases/$(database)/documents/tenants/$(t)/workOrders/$(orderId)/report/ficha; }
          function fSinFirmar(){
            return !exists(fFicha()) || get(fFicha()).data.get('firmaCliente', null) == null;
          }

          allow read: if isManager(t) || fMia()
            || (isCustomer(t) && fOrd().clientId == myClientId(t));

          // La ficha liviana: solo la miniatura. Es lo que se lista en el
          // celular, para no bajar las fotos grandes sin necesidad.
          allow create: if tenantActive(t) && (isManager(t) || fMia())
            && newData().keys().hasOnly(['fase', 'thumb', 'nota', 'by', 'byName', 'at'])
            && newData().fase in ['antes', 'durante', 'despues']
            && newData().by == uid() && newData().at == request.time
            && str(newData().thumb, 100, 80000)
            && optStr(newData(), 'nota', 300)
            && optStr(newData(), 'byName', 100);

          // Una foto no se edita nunca. Se puede borrar solo mientras el
          // cliente no haya firmado: después es parte de la evidencia.
          allow update: if false;
          allow delete: if tenantActive(t) && (isManager(t) || fMia()) && fSinFirmar();
        }

        // La foto en tamaño bueno, en un documento aparte. Solo se descarga
        // cuando alguien la abre o imprime el reporte.
        match /photoFiles/{photoId} {
          function gOrd()  { return get(/databases/$(database)/documents/tenants/$(t)/workOrders/$(orderId)).data; }
          function gMia()  { return isTech(t) && gOrd().techUid == uid(); }
          function gFicha(){ return /databases/$(database)/documents/tenants/$(t)/workOrders/$(orderId)/report/ficha; }

          allow read: if isManager(t) || gMia()
            || (isCustomer(t) && gOrd().clientId == myClientId(t));
          allow create: if tenantActive(t) && (isManager(t) || gMia())
            && newData().keys().hasOnly(['data'])
            && str(newData().data, 100, 900000);
          allow update: if false;
          allow delete: if tenantActive(t) && (isManager(t) || gMia())
            && (!exists(gFicha()) || get(gFicha()).data.get('firmaCliente', null) == null);
        }

        // Historial inmutable de la orden
        match /events/{eventId} {
          allow read: if isManager(t)
            || (isTech(t) && get(/databases/$(database)/documents/tenants/$(t)/workOrders/$(orderId)).data.techUid == uid())
            || (isCustomer(t) && get(/databases/$(database)/documents/tenants/$(t)/workOrders/$(orderId)).data.clientId == myClientId(t));
          allow create: if tenantActive(t)
            && (isManager(t) || (isTech(t) && get(/databases/$(database)/documents/tenants/$(t)/workOrders/$(orderId)).data.techUid == uid()))
            && newData().keys().hasOnly(['type', 'status', 'note', 'by', 'byName', 'at', 'lat', 'lng'])
            && newData().by == uid() && newData().at == request.time
            && str(newData().type, 2, 40) && optStr(newData(), 'note', 2000) && optStr(newData(), 'byName', 100)
            && (!('lat' in newData()) || newData().lat == null || newData().lat is number)
            && (!('lng' in newData()) || newData().lng == null || newData().lng is number);
          allow update, delete: if false;
        }
      }

      function transitionOk(from, to, allowed) {
        return from == to || (from + '>' + to) in allowed;
      }

      function validOrder(d) {
        return d.keys().hasOnly(['seq', 'number', 'branchId', 'clientId', 'clientName', 'siteId', 'siteName',
                                 'assetId', 'assetCode', 'type', 'priority', 'techId', 'techUid', 'techName',
                                 'scheduledDate', 'scheduledTime', 'description', 'status', 'statusNote',
                                 'startedAt', 'completedAt', 'contractId',
                                 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && optStr(d, 'contractId', 64)
          && d.seq is int && d.seq > 0 && str(d.number, 3, 20)
          && str(d.clientId, 1, 64) && str(d.clientName, 1, 150)
          && str(d.siteId, 1, 64) && str(d.siteName, 1, 120)
          && d.type in ['preventivo', 'correctivo', 'instalacion', 'emergencia']
          && d.priority in ['normal', 'media', 'alta', 'critica']
          && d.status in ['pendiente', 'programada', 'en_ruta', 'en_servicio', 'completada', 'cancelada']
          && isDate(d.scheduledDate) && optTime(d, 'scheduledTime')
          && optStr(d, 'description', 4000) && optStr(d, 'statusNote', 2000) && optStr(d, 'branchId', 64)
          && optStr(d, 'assetCode', 30) && optStr(d, 'techName', 100)
          && (d.type == 'instalacion' || d.get('contractId', null) is string || d.get('assetId', null) is string)
          && (d.status != 'pendiente' || d.get('techId', null) == null)
          && (!(d.status in ['programada', 'en_ruta', 'en_servicio', 'completada']) || d.get('techId', null) is string)
          && (d.status != 'cancelada' || (d.get('statusNote', null) is string && d.statusNote.size() >= 5));
      }

      // ---------------- Bitácora de auditoría ----------------
      // La escribe la app, pero una vez escrita no se toca nunca más.
      match /auditLog/{entryId} {
        allow read:   if isAdmin(t);
        allow create: if isManager(t) && tenantActive(t)
          && newData().by == uid() && newData().at == request.time;
        allow update, delete: if false;
      }
    }
  }
}
