{
  "name": "hvac360-firebase",
  "version": "0.2.0",
  "private": true,
  "description": "HVAC 360° - Fase 1.5 - modelo de datos y reglas multiempresa en Firebase (plan gratuito Spark)",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-hvac360 \"node --test tests/reglas.test.js\"",
    "emuladores": "firebase emulators:start --project demo-hvac360",
    "publicar-reglas": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.30.1"
  }
}
